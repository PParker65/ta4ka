{
  "name": "snelfix-auto",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wordmark": "node scripts/wordmark.mjs",
    "build": "node scripts/wordmark.mjs && vite build",
    "dev": "npm run build && node --experimental-sqlite --disable-warning=ExperimentalWarning server/local.mjs",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning server/local.mjs",
    "smoke": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/source-sans-3": "^5.2.8",
    "@fontsource/unbounded": "^5.3.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "vite": "^6.3.6",
    "wrangler": "^4.42.0"
  }
}
