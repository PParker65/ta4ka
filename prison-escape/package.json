{
  "name": "prison-escape",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first third-person 3D prison escape (Three.js + Vite + Tailwind)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "build:desktop": "BASE_PATH=./ vite build",
    "desktop": "npm run build:desktop && electron .",
    "pack:desktop": "npm run build:desktop && node scripts/pack-desktop.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.14",
    "electron": "^33.2.1",
    "tailwindcss": "^4.0.14",
    "vite": "^6.2.0"
  }
}
